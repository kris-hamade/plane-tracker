# RapidAPI key for ADSBexchange
# Get your API key from: https://rapidapi.com/adsbexchange-com1-adsbexchange-com1-default/api/adsbexchange-com1
RAPIDAPI_KEY=your-rapidapi-key-here

# Aircraft ICAO24/HEX code (6 hex characters, e.g. 4844e6)
# Can also be set/updated via API endpoint
ICAO24=4844e6

# API server port (default: 3000)
API_PORT=3000

# Optional: API key for securing the API endpoints
# If set, include in requests: Authorization: Bearer <API_KEY>
# Or as query parameter: ?key=<API_KEY>
API_KEY=

# Discord webhook URL
# Create one at: https://discord.com/developers/applications -> Your App -> Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url-here

# Polling interval in seconds when aircraft is AIRBORNE (default: 300 = 5 minutes)
POLL_SECONDS=300

# Polling interval in seconds when aircraft is ON_GROUND (default: 900 = 15 minutes)
GROUND_POLL_SECONDS=900

# State check interval in seconds - how often to check if plane is on-ground or airborne (default: 1800 = 30 minutes)
STATE_CHECK_INTERVAL_SECONDS=1800

# Position update interval in seconds when aircraft is AIRBORNE (default: 300 = 5 minutes)
UPDATE_INTERVAL_SECONDS=300

# Optional: Mapbox token for map image attachments
# Get one at: https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=

# Optional: Map image dimensions (default: 900x500)
MAP_W=900
MAP_H=500

